NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Comma-separated, exact origins without trailing slashes.
FRONTEND_ORIGIN=http://localhost:5173,https://bitelinkqr.onrender.com

# Use Supabase's Session pooler URL (port 5432) on IPv4-only networks.
# A direct db.PROJECT_REF.supabase.co URL is IPv6-only unless IPv4 is enabled.
# Never expose this value to Vite or commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Supabase project URL, for example https://PROJECT_REF.supabase.co
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
BOOTSTRAP_TOKEN=replace-with-a-long-one-time-bootstrap-token

# Storage is provider-based: "supabase" now, "local" or "s3" later.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=BiteLinkQR
STORAGE_MAX_BYTES=5242880
STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_PUBLIC_URL=http://127.0.0.1:4000/uploads

# Set true only while developing the UI without a configured database.
ALLOW_DEMO_AUTH=false
